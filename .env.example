# Copy this file to .env (same folder) and put your own keys in it.
# .env is git-ignored: never commit real keys.

# AI chat assistant (free key: https://console.groq.com -> API Keys)
GROQ_API_KEY=your_groq_key_here
# Optional: force a model (otherwise the best available one is picked)
# GROQ_MODEL=openai/gpt-oss-120b

# Optional alternative to Groq
# ANTHROPIC_API_KEY=your_anthropic_key_here
